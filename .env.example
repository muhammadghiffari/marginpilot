# Copy to .env (never commit .env). Testnet-only keys. Never reuse a mainnet key.

# --- Chain ---
# simulated (default) | anvil | testnet. Use anvil/testnet only with a funded
# testnet account and a public RPC; mainnets are refused by the agent.
CHAIN_MODE=simulated
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
EXPLORER_BASE_URL=
ETHERSCAN_API_KEY=

# --- Keys (generate fresh with: cast wallet new) ---
DEPLOYER_PRIVATE_KEY=
EXECUTOR_PRIVATE_KEY=
DEMO_OWNER_PRIVATE_KEY=
# Real owner address for wallet-mode signing (public address, not a key)
OWNER_ADDRESS=
# Executor hot-key address (public address, not a key). Required off chain 31337.
EXECUTOR_ADDRESS=

# --- LLM (D-036; key only in the human's .env, never commit or log it) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_TIMEOUT_MS=60000

# --- Server / demo ---
PORT=8787
# Bind loopback by default. Set HOST=0.0.0.0 only behind a trusted proxy/firewall.
HOST=127.0.0.1
DEMO_MODE=true
# Chain mode: allow the scenario lab's owner/admin writes. Keep false for a
# public deployment that only needs the rescue flow.
ALLOW_DEMO_CONTROLS=false
DEMO_MAX_RUNS_PER_HOUR=20
RATE_LIMIT_CAPACITY=120
RATE_LIMIT_REFILL_PER_SECOND=2
AUDIT_LOG_PATH=./evidence/audit.jsonl
