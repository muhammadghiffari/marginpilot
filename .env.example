# Copy to .env (never commit .env). Testnet-only keys. Never reuse a mainnet key.

# --- Chain ---
CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545
RPC_URL_FALLBACK=
EXPLORER_BASE_URL=
ETHERSCAN_API_KEY=

# --- Keys (generate fresh with: cast wallet new) ---
DEPLOYER_PRIVATE_KEY=
EXECUTOR_PRIVATE_KEY=
DEMO_OWNER_PRIVATE_KEY=
# Real owner address for wallet-mode signing (public address, not a key)
OWNER_ADDRESS=

# --- LLM (D-006) ---
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0
MAX_TOOL_CALLS=30
MAX_REPLANS=3
MAX_PLAN_AGE_BLOCKS=2

# --- Server / demo ---
PORT=8787
DEMO_MODE=true
DEMO_MAX_RUNS_PER_HOUR=20
AUDIT_LOG_PATH=./evidence/audit.jsonl
