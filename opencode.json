{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["STATUS.md", "docs/DECISIONS.md"],
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "**/.secrets/**": "deny",
      "**/.git-credentials": "deny",
      "**/.ssh/**": "deny",
      "**/.config/gh/**": "deny",
      "**/.netrc": "deny"
    },
    "edit": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow",
      "opencode.json": "ask",
      "AGENTS.md": "ask"
    },
    "bash": {
      "*": "ask",
      "ls *": "allow",
      "pwd": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "git checkout *": "allow",
      "git switch *": "allow",
      "git pull *": "allow",
      "git rebase *": "ask",
      "git push *": "ask",
      "git fetch *": "allow",
      "git merge *": "allow",
      "git push origin *": "allow",
      "git push -u origin *": "allow",
      "forge build": "allow",
      "forge build *": "allow",
      "forge test": "allow",
      "forge test *": "allow",
      "forge fmt *": "allow",
      "forge inspect *": "allow",
      "pnpm install": "allow",
      "pnpm install *": "allow",
      "pnpm test": "allow",
      "pnpm -r *": "allow",
      "pnpm eval:*": "allow",
      "pnpm exec *": "allow",
      "pnpm run *": "allow",
      "node *": "allow",
      "python3 *": "allow",
      "bash scripts/*": "allow",
      "scripts/*": "allow",
      "scripts/deploy*": "ask",
      "bash scripts/deploy*": "ask",
      "anvil *": "ask",
      "forge script *": "ask",
      "cast send *": "ask",
      "git push --force*": "deny",
      "git push * --force*": "deny",
      "git push * -f*": "deny",
      "git push * --delete*": "deny",
      "git reset --hard*": "deny",
      "rm -rf *": "deny",
      "sudo *": "deny",
      "cast wallet *": "deny",
      "cat .env*": "deny",
      "cat *.env": "deny",
      "printenv*": "deny",
      "env": "deny",
      "env *": "deny",
      "* | sh": "deny",
      "* | bash": "deny"
    }
  }
}
